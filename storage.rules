rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile images: scoped strictly to profile-images/{userId}/...
    match /profile-images/{userId}/{allPaths=**} {
      // Authenticated users can read profile images
      allow read: if request.auth != null;
      // Authenticated users can only create, update, or delete in their own directory
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Exercise media (admin managed)
    match /exercise-media/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
