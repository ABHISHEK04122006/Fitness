<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fitness" parent="@android:style/Theme.Material.NoActionBar">
        <!-- Pure Pitch Black Window & Background -->
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Android 12+ System Splash Screen in Pure Pitch Black -->
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#000000</item>
    </style>
</resources>
